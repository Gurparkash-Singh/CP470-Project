<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterScreen2">

    <ScrollView
        android:id="@+id/Register2ScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/Register2LL1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/RegisterTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="@string/text_register_title"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/FirstNameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="48dp"
                android:text="@string/enter_fname"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/EnterFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:ems="10"
                android:hint="@string/mandatory_warning"
                android:inputType="text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/LastNameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:text="@string/enter_lname"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/EnterLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:ems="10"
                android:hint="@string/optional_warning"
                android:inputType="text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/AgeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:text="@string/age_title"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/Register2LL2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/EnterAgeNumber"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="2dp"
                    android:ems="10"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/AgeNoticeNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:layout_weight="1"
                    android:gravity="center|top"
                    android:text="@string/age_notice_note_text" />
            </LinearLayout>

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:backgroundTint="#000000"
                android:backgroundTintMode="add" />

            <TextView
                android:id="@+id/PreferredTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="36dp"
                android:gravity="center"
                android:text="@string/preferred_title" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <CheckBox
                        android:id="@+id/ChBxAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxAdventure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adventure"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/animation"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxAnime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/anime"
                        android:textSize="12sp" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <CheckBox
                        android:id="@+id/ChBxBiography"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/biography"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxComedy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comedy"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChbxCrime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/crime"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxDocumentary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/documentary"
                        android:textSize="12sp" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <CheckBox
                        android:id="@+id/ChBxDrama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drama"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxFamily"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/family"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxFantasy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fantasy"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history"
                        android:textSize="12sp" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <CheckBox
                        android:id="@+id/ChBxHorror"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/horror"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxMusical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/musical"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxMystery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mystery"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxRomance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/romance"
                        android:textSize="12sp" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <CheckBox
                        android:id="@+id/ChBxSciFi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sci_fi"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxSeasonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seasonal"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxSport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/ChBxThriller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/thriller"
                        android:textSize="12sp" />
                </TableRow>
            </TableLayout>

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:backgroundTint="#000000"
                android:backgroundTintMode="add" />

            <Button
                android:id="@+id/DoneButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="24dp"
                android:text="@string/done" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>